FROM node:22-alpine
WORKDIR /app
COPY --chown=node:node server ./server
COPY --chown=node:node shared ./shared
COPY --chown=node:node package.json ./package.json
RUN mkdir /data && chown node:node /data
USER node
ENV NODE_ENV=production TRAFFIC_HOST=0.0.0.0 TRAFFIC_PORT=3001 TRAFFIC_BUDGET_FILE=/data/opensky-budget.json TRAFFIC_METADATA_FILE=/data/aircraft-metadata.json
EXPOSE 3001
HEALTHCHECK --interval=30s --timeout=5s CMD node -e "fetch('http://127.0.0.1:3001/api/traffic/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "server/trafficServer.mjs"]
