# Free tokens: https://ion.cesium.com/tokens
# On every Cesium ion account add Google Photorealistic 3D Tiles (asset 2275207).
# Comma-separated pool — the game rotates to the next key on HTTP 429.
VITE_CESIUM_ION_KEYS=
# Still accepted as the first key if ION_KEYS is empty:
# VITE_CESIUM_ION_KEY=

# Optional extra Google Map Tiles API keys (own quota per Cloud project).
# VITE_GOOGLE_TILES_KEYS=
# VITE_GOOGLE_MAPS_KEY=

# Backend only. Never prefix OpenSky credentials with VITE_.
OPEN_SKY_CLIENT_ID=
OPEN_SKY_CLIENT_SECRET=
# Local dev proxies /api/traffic automatically. For GitHub Pages use your HTTPS backend origin.
VITE_TRAFFIC_API_BASE=
# TRAFFIC_HOST=127.0.0.1
# TRAFFIC_PORT=3001
# TRAFFIC_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# TRAFFIC_BUDGET_FILE=.data/opensky-budget.json
